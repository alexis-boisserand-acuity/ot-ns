set -euo pipefail

ZEPHYR_SRCDIR="$(cd "$(dirname "$0")/.." && pwd)"
OTNS_ROOT="$(cd "${ZEPHYR_SRCDIR}/.." && pwd)"
readonly ZEPHYR_SRCDIR
readonly OTNS_ROOT

readonly ZEPHYR_REV="v4.5.0-rc3"

install_system_packages()
{
    if ! command -v apt-get >/dev/null 2>&1; then
        echo "error: apt-get not found; install the Zephyr host dependencies manually:" >&2
        echo "  https://docs.zephyrproject.org/latest/develop/getting_started/installation_linux.html" >&2
        exit 1
    fi

    local -a pkgs=(
        git cmake ninja-build gperf ccache dfu-util device-tree-compiler wget
        python3-dev python3-venv python3-tk xz-utils file make gcc
        libsdl2-dev libmagic1 gcc-multilib g++-multilib
    )

    sudo apt-get update
    sudo apt-get install -y --no-install-recommends "${pkgs[@]}"
}

check_prereqs()
{
    local cmd
    for cmd in git python3; do
        if ! command -v "${cmd}" >/dev/null 2>&1; then
            echo "error: '${cmd}' not found on PATH" >&2
            exit 1
        fi
    done
    if ! python3 -c 'import sys; sys.exit(sys.version_info < (3, 12))'; then
        echo "error: Python 3.12 or newer is required by Zephyr main" >&2
        exit 1
    fi
}

write_manifest()
{
    local ws="$1"

    mkdir -p "${ws}/manifest"
    cat >"${ws}/manifest/west.yml" <<EOF
# Generated by setup_zephyr_env; do not edit.
manifest:
  version: "1.0"
  remotes:
    - name: zephyrproject-rtos
      url-base: https://github.com/zephyrproject-rtos
  projects:
    - name: zephyr
      remote: zephyrproject-rtos
      revision: ${ZEPHYR_REV}
      path: zephyr
      west-commands: scripts/west-commands.yml
      import:
        name-allowlist:
          - mbedtls
          - tf-psa-crypto
EOF
}

setup_west()
{
    local ws="$1"
    local west="${ws}/.venv/bin/west"

    if [[ ! -d "${ws}/.venv" ]]; then
        python3 -m venv "${ws}/.venv"
    fi
    "${ws}/.venv/bin/pip" install --quiet west
    if [[ ! -d "${ws}/.west" ]]; then
        (cd "${ws}" && "${west}" init -l manifest)
    fi
    (cd "${ws}" && "${west}" update --narrow --fetch-opt=--depth=1)
    (cd "${ws}" && "${west}" packages pip --install)
    (cd "${ws}" && "${west}" zephyr-export)
}

install_sdk()
{
    local ws="$1"
    local west="${ws}/.venv/bin/west"

    (cd "${ws}/zephyr" && "${west}" sdk install --no-gnu-toolchains)
}

main()
{
    install_system_packages
    check_prereqs

    local ws="${1:-${OTNS_ROOT}/../zephyr-workspace}"
    mkdir -p "${ws}"
    ws="$(cd "${ws}" && pwd)"

    write_manifest "${ws}"
    setup_west "${ws}"
    install_sdk "${ws}"

    cat <<EOF

Zephyr workspace ready: ${ws}

To build the OTNS Zephyr nodes:
  source "${ws}/.venv/bin/activate"
  export ZEPHYR_BASE="${ws}/zephyr"
  cd "${ZEPHYR_SRCDIR}" && ./script/build_latest

EOF
}

main "$@"
