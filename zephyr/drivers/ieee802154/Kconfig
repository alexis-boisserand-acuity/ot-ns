
config IEEE802154_OTNS
	bool "OpenThread Network Simulator (OTNS) IEEE 802.15.4 driver"
	default y
	depends on DT_HAS_ZEPHYR_IEEE802154_OTNS_ENABLED
	depends on ARCH_POSIX
	depends on NATIVE_LIBRARY
	depends on NET_L2_OPENTHREAD
	select SHELL
	select OPENTHREAD_SHELL
	select NET_PKT_TIMESTAMP
	help
	  Virtual IEEE 802.15.4 radio driver for the native_sim board that
	  connects to the OpenThread Network Simulator (OTNS) over a Unix domain
	  socket. It lets a Zephyr native_sim node take part in an OTNS
	  simulation, interoperating with other (ot-cli / ot-rfsim) OTNS nodes.

	  The driver bridges the Zephyr ieee802154_radio_api to the OTNS
	  simulation-event protocol and synchronizes the native_sim virtual
	  clock with the OTNS virtual time (lock-step).

if IEEE802154_OTNS

config IEEE802154_OTNS_CLI_LEGACY_CSL_PERIOD
	bool "Legacy 'csl period' CLI unit (10 symbols) in the OTNS CLI bridge"
	help
	  OpenThread versions up to Thread 1.3 take the 'csl period' CLI
	  argument in units of 10 symbols (160 us), while current OpenThread
	  takes it in microseconds. OTNS sends the legacy unit to nodes it
	  considers to be v12/v13. Enable this for Zephyr builds that emulate
	  those versions on top of current OpenThread code: the CLI bridge then
	  converts the 'csl period' argument to microseconds.

module = IEEE802154_OTNS
module-str = ieee802154 OTNS
source "subsys/logging/Kconfig.template.log_config"

endif # IEEE802154_OTNS
